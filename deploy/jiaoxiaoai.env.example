# Copy this file to deploy/jiaoxiaoai.env. Never commit the real file: it
# contains provider and tool-server credentials.

# Branding and test authentication. The first account remains the bootstrap
# administrator; later sign-ups become ordinary users immediately.
WEBUI_NAME=交小AI
DEFAULT_USER_ROLE=user
ENABLE_SIGNUP=true

# Administrator-owned provider. Students never receive this key.
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=replace-me

# One-time managed model bootstrap. JIAOXIAOAI_BASE_MODEL_ID must be an ID
# returned by the provider above. Existing model rows are never overwritten.
JIAOXIAOAI_BASE_MODEL_ID=replace-with-provider-model-id
JIAOXIAOAI_MODEL_ID=jiaoxiaoai
JIAOXIAOAI_MODEL_NAME=交小AI
JIAOXIAOAI_MODEL_PARAMS={}
# After Knowledge/Tools exist, their stable IDs can be recorded here for a
# fresh database. Example tool IDs: local-tool-id or server:mcp:mcp-server-id.
JIAOXIAOAI_MODEL_METADATA={"capabilities":{"builtin_tools":true,"file_context":true},"knowledge":[],"toolIds":["server:mcp:amap"]}
DEFAULT_MODELS=jiaoxiaoai
DEFAULT_PINNED_MODELS=jiaoxiaoai
MODEL_ORDER_LIST=jiaoxiaoai

# Official AMap Streamable HTTP MCP. Replace the placeholder server-side, then
# use Admin > Connections to enable it and grant read access to a student group.
# It starts disabled and private. The exact query-only allowlist deliberately
# excludes IP location and any future personal-map/navigation action tools.
TOOL_SERVER_CONNECTIONS=[{"url":"https://mcp.amap.com/mcp?key=replace-with-amap-mcp-key","path":"","type":"mcp","auth_type":"none","headers":{},"key":"","config":{"enable":false,"function_name_filter_list":"maps_regeocode,maps_geo,maps_weather,maps_bicycling,maps_direction_walking,maps_direction_driving,maps_direction_transit_integrated,maps_distance,maps_text_search,maps_around_search,maps_search_detail","access_grants":[]},"info":{"id":"amap","name":"高德地图","description":"高德官方地图、POI、天气与路线查询（只读）"}}]

# Platform configuration remains administrator-owned.
ENABLE_DIRECT_CONNECTIONS=false
ENABLE_API_KEYS=false
USER_PERMISSIONS_WORKSPACE_MODELS_ACCESS=false
USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ACCESS=false
USER_PERMISSIONS_WORKSPACE_PROMPTS_ACCESS=false
USER_PERMISSIONS_WORKSPACE_TOOLS_ACCESS=false
USER_PERMISSIONS_WORKSPACE_SKILLS_ACCESS=false
USER_PERMISSIONS_FEATURES_DIRECT_TOOL_SERVERS=false
USER_PERMISSIONS_FEATURES_API_KEYS=false

# Keep the student navigation focused on chat for phase one. These can be
# enabled later without changing the authentication integration.
ENABLE_FOLDERS=false
ENABLE_NOTES=false
ENABLE_CHANNELS=false
ENABLE_MEMORIES=false
ENABLE_AUTOMATIONS=false
ENABLE_CALENDAR=false
USER_PERMISSIONS_FEATURES_FOLDERS=false
USER_PERMISSIONS_FEATURES_NOTES=false
USER_PERMISSIONS_FEATURES_CHANNELS=false
USER_PERMISSIONS_FEATURES_MEMORIES=false
USER_PERMISSIONS_FEATURES_AUTOMATIONS=false
USER_PERMISSIONS_FEATURES_CALENDAR=false

# Production deployments must set a stable random value.
WEBUI_SECRET_KEY=replace-with-a-long-random-secret

