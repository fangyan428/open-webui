# Docker Compose reads this optional root .env only for image/build/port
# interpolation. Never put API keys, OAuth/JAccount secrets or other runtime
# credentials here; those belong exclusively in deploy/jiaoxiaoai.env.

JIAOXIAOAI_IMAGE=jiaoxiaoai:local
JIAOXIAOAI_BOCHA_MCP_IMAGE=jiaoxiaoai-bocha-mcp:0.1.0
JIAOXIAOAI_LISTEN_ADDR=127.0.0.1
JIAOXIAOAI_PORT=3001

# Optional mirrors/proxy for restricted build networks.
JIAOXIAOAI_BUILD_NETWORK=default
JIAOXIAOAI_ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
JIAOXIAOAI_DEBIAN_MIRROR=http://deb.debian.org
JIAOXIAOAI_NPM_REGISTRY=https://registry.npmjs.org
JIAOXIAOAI_PYPI_INDEX_URL=https://pypi.org/simple
JIAOXIAOAI_PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
JIAOXIAOAI_HF_ENDPOINT=https://huggingface.co
JIAOXIAOAI_HF_HUB_DISABLE_XET=false
JIAOXIAOAI_NODE_MAX_OLD_SPACE_SIZE=8192
# JIAOXIAOAI_BUILD_PROXY=http://proxy.example:port
# JIAOXIAOAI_BUILD_NO_PROXY=localhost,127.0.0.1,::1
# JIAOXIAOAI_TIKTOKEN_TOKENIZER_URL=https://example/cl100k_base.json
